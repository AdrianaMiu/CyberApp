      "difficulty": "basic",
      "type": "single",
      "question": "What is the main purpose of running a DLP policy in monitor-only mode?",
      "options": [
        {
          "id": "a",
          "text": "Block every transfer that matches"
        },
        {
          "id": "b",
          "text": "Log matches so analysts can tune the policy before enforcement"
        },
        {
          "id": "c",
          "text": "Encrypt all matched files"
        },
        {
          "id": "d",
          "text": "Delete matched files automatically"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": {
        "correct": "Monitor mode records matches without blocking, which exposes false positives before enforcement starts.",
        "distractors": {
          "a": "Blocking is enforcement mode, not monitor mode.",
          "c": "Encryption is a separate protection action.",
          "d": "Deleting data is not a standard DLP monitor action."
        }
      }
    },

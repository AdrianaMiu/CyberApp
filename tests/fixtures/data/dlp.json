      "id": "dlp-0006",
      "domain": "dlp",
      "layer": "L2",
      "sector": "mssp-consulting",
      "difficulty": "intermediate",
      "type": "truefalse",
      "question": "It is acceptable to close an alert as a false positive only because the sender works in a team that handles that data type every day.",
      "options": [
        {
          "id": "a",
          "text": "True"
        },
        {
          "id": "b",
          "text": "False"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": {
        "correct": "Role alone does not justify closure; the destination, volume and approval still need checking.",
        "distractors": {
          "a": "Handling the data does not make sending it to an unapproved external destination legitimate."
        }
      }

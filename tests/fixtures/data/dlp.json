      "difficulty": "intermediate",
      "type": "single",
      "question": "Which piece of alert metadata best confirms whether an emailed file actually left the organisation?",
      "options": [
        {
          "id": "a",
          "text": "The delivery status of the message"
        },
        {
          "id": "b",
          "text": "The file name"
        },
        {
          "id": "c",
          "text": "The sender display name"
        },
        {
          "id": "d",
          "text": "The policy description"
        }
      ],
      "answer": [
        "a"
      ],
      "explanation": {
        "correct": "Delivery status distinguishes delivered from quarantined or blocked messages.",
        "distractors": {
          "b": "A name says nothing about delivery.",
          "c": "A display name says nothing about delivery.",
          "d": "A description is static text."
        }
      }

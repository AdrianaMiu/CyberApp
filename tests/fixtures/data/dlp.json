      "question": "A DLP false positive is an alert where the policy matched but no real policy violation occurred.",
      "options": [
        {
          "id": "a",
          "text": "True"
        },
        {
          "id": "b",
          "text": "False"
        }
      ],
      "answer": [
        "a"
      ],
      "explanation": {
        "correct": "That is the definition: the pattern matched, the context was legitimate.",
        "distractors": {
          "b": "The statement is the standard definition, so it is true."
        }
      }

      "attack": [
        "T1048.003"
      ],
      "question": "Customer IBANs were emailed to an external recipient. Which statements about regulatory handling are correct?",
      "options": [
        {
          "id": "a",
          "text": "The 72-hour GDPR clock starts when the controller becomes aware of the breach"
        },
        {
          "id": "b",
          "text": "Notifying the supervisory authority is always required, whatever the risk"
        },
        {
          "id": "c",
          "text": "The breach must be documented internally even when no notification is made"
        },
        {
          "id": "d",
          "text": "DORA incident reporting never applies to banks"
        }
      ],
      "answer": [
        "a",
        "c"
      ],
      "explanation": {
        "correct": "GDPR art. 33 starts the 72 hours at awareness and requires documentation of every breach.",
        "distractors": {
          "b": "Notification is not required when the breach is unlikely to result in a risk to individuals.",
          "d": "DORA applies to financial entities for major ICT-related incidents."
        }
      }
    },

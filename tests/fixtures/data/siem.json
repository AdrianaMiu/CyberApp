      "question": "What is this detection query trying to find?",
      "context": "SigninLogs\n| where ResultType == 0\n| summarize countries = dcount(Location) by UserPrincipalName, bin(TimeGenerated, 1h)\n| where countries > 2",
      "options": [
        {
          "id": "a",
          "text": "Accounts with successful sign-ins from more than two countries within one hour"
        },
        {
          "id": "b",
          "text": "Accounts with failed MFA challenges"
        },
        {
          "id": "c",
          "text": "Newly registered MFA devices"
        },
        {
          "id": "d",
          "text": "Disabled accounts that still sign in"
        }
      ],
      "answer": [
        "a"
      ],
      "explanation": {
        "correct": "ResultType 0 is success; dcount(Location) per hour above two flags implausible geographic spread.",
        "distractors": {
          "b": "The query filters on successful results, not MFA failures.",
          "c": "Device registration is another log table.",
          "d": "Nothing in the query checks account state."
        }

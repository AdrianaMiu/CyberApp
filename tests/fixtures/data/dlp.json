      "difficulty": "intermediate",
      "type": "single",
      "question": "A ticket describing a DLP alert contains the text <img src=x onerror=\"window.__pwned=1\"> pasted by a user. How should the analyst treat it?",
      "context": "ticket body: <img src=x onerror=\"window.__pwned=1\">",
      "options": [
        {
          "id": "a",
          "text": "Render it as HTML so the image is visible: <img src=x onerror=\"window.__pwned=1\">"
        },
        {
          "id": "b",
          "text": "Treat it as untrusted text and never render or execute it as markup"
        },
        {
          "id": "c",
          "text": "Run it in the browser console to see what it does"
        },
        {
          "id": "d",
          "text": "Ignore the alert because the ticket looks corrupted"
        }
      ],
      "answer": [
        "b"
      ],
      "explanation": {
        "correct": "User-supplied text is untrusted data; showing it literally avoids executing attacker-controlled markup.",
        "distractors": {
          "a": "Rendering untrusted markup can run script in the analyst browser.",
          "c": "Executing unknown content is unsafe and answers nothing about the alert.",
          "d": "Odd text in a ticket does not invalidate the underlying alert."
        }
      }
    },
